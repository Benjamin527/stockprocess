{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist-server",
    "rootDir": ".",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": false,
    "types": ["node"]
  },
  "include": ["server/**/*.ts", "src/lib/calendar.ts", "src/lib/types.ts"],
  "exclude": ["**/*.test.ts", "dist", "dist-server", "node_modules"]
}
